# ---------------------------------------------------------------------------
# Acumen Gate Academy - environment configuration
# Copy to .env.local and fill in. The public site runs WITHOUT these set
# (it falls back to the seed content in src/lib/defaults.ts), but the admin
# panel, lead capture and payments all require Supabase.
# ---------------------------------------------------------------------------

# --- Supabase (SRS 4) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for lead writes + admin reads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead notification (SRS 10.2) ------------------------------------------
# Where new-lead alert emails are sent. PENDING from client (SRS 12).
LEAD_NOTIFICATION_EMAIL=
# SMTP for outbound mail (lead alerts + GST invoice to student).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Payments (SRS 11) -----------------------------------------------------
# Provider PENDING (SRS 12) - blocking dependency for a required feature.
# Supported values: "stub" (logs only, no money moves) | "razorpay"
PAYMENT_PROVIDER=stub
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# GST invoicing (SRS 11.3) - PENDING from client (SRS 12), required before launch.
GST_RATE_PERCENT=18
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=
BUSINESS_ADDRESS=

# --- SMS / WhatsApp (SRS 10.2) ---------------------------------------------
# Provider PENDING (SRS 12). Supported: "stub" (logs only) | "msg91" | "twilio"
MESSAGING_PROVIDER=stub
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=
MESSAGING_ACCOUNT_SID=
