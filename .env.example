# ---------------------------------------------------------------------------
# Acumen Gate Academy - environment configuration
# Copy to .env.local and fill in. The public site runs WITHOUT these set
# (it falls back to the seed content in src/lib/defaults.ts), but the admin
# panel, lead capture and payments all require Supabase.
# ---------------------------------------------------------------------------

# --- Supabase (SRS 4) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for lead writes + admin reads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead notification (SRS 10.2) ------------------------------------------
# Where new-lead alert emails are sent. PENDING from client (SRS 12).
LEAD_NOTIFICATION_EMAIL=
# SMTP for outbound mail (lead alerts + GST invoice to student).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Payments (SRS 11) -----------------------------------------------------
# "razorpay" (Standard Checkout) | "stub" (local simulator, no money moves)
PAYMENT_PROVIDER=stub
# Razorpay Dashboard -> Account & Settings -> API Keys. rzp_test_... for testing,
# rzp_live_... in production. The secret is server-only.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# Any long random string; enter the same value on the Razorpay webhook.
PAYMENT_WEBHOOK_SECRET=
# GST invoicing (SRS 11.3). Supplied by the client (see docs/PENDING.md A2);
# the real values live in .env.local and the host's env vars, not here.
# Without them no invoice is issued. Batch fees are GST-inclusive.
GST_RATE_PERCENT=18
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=
BUSINESS_ADDRESS=

# --- Student confirmations: WhatsApp (SRS 10.2) -----------------------------
# "meta" sends WhatsApp templates through the Meta Cloud API.
# Also supported: "stub" (logs only, sends nothing) | "msg91" | "twilio" (SMS)
MESSAGING_PROVIDER=stub

# Meta Cloud API - same WhatsApp number as the academy's Apps Script bot.
# Use a permanent System User token, ideally one made just for the website.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en
# Template names. Leave blank for the defaults below; "off" stops that message.
WHATSAPP_TEMPLATE_ENQUIRY=        # default: enquiry_received
WHATSAPP_TEMPLATE_DEMO=           # default: demo_class_booked
WHATSAPP_TEMPLATE_SEMINAR=        # default: seminar_registration
WHATSAPP_TEMPLATE_ENROLLMENT=     # default: enrollment_confirmed

# SMS providers only (not in use)
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=
MESSAGING_ACCOUNT_SID=
